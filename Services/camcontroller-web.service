# /etc/systemd/system/camcontroller-web.service
[Unit]
Description=CamController Web Interface - Gunicorn-instans for att servera Flask kamerainstallningar
After=network.target camcontroller.service
Wants=network.target
[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/PyRpiCamController/WebGui
ExecStartPre=/bin/bash /home/pi/PyRpiCamController/Services/wait_for_real_network.sh
ExecStartPre=/bin/mkdir -p /home/pi/shared/logs
# If installed via apt:
ExecStart=/usr/bin/gunicorn -w 2 -b 0.0.0.0:80 --access-logfile /home/pi/shared/logs/camcontroller_web_access.log --error-logfile /home/pi/shared/logs/camcontroller_web_error.log --capture-output --log-level info web_app:app
# Uses port 80 when ComitUp is not running (network available)
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=10
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONPATH=/home/pi/PyRpiCamController"
[Install]
WantedBy=multi-user.target
