[Unit]
Description=PyRpiCamController Update Daemon
Documentation=https://github.com/teddycool/PyRpiCamController
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/pi/PyRpiCamController
Environment=PYTHONPATH=/home/pi/PyRpiCamController
ExecStartPre=/bin/bash /home/pi/PyRpiCamController/Services/wait_for_real_network.sh
ExecStart=/usr/bin/python3 /home/pi/PyRpiCamController/Updates/camcontroller_update_daemon.py --daemon
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/home/pi/PyRpiCamController /home/pi/shared/logs /home/pi/ota /etc/systemd/system
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=default
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

# Resource limits
MemoryHigh=256M
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
