# CamController OTA Backend — Apache configuration
# Place this file in the root of the pycamota/ deployment directory.

Options -Indexes
DirectoryIndex admin/admin_dashboard.php

# ---------------------------------------------------------------------------
# Block direct access to sensitive directories
# ---------------------------------------------------------------------------
<FilesMatch "\.(sql|md|json|log|sh|py)$">
    Require all denied
</FilesMatch>

# .htaccess context-safe protection for sensitive folders
RewriteEngine On
RewriteRule ^(utils|database)(/|$) - [F,L]

# ---------------------------------------------------------------------------
# URL routing — map clean API paths to PHP files
#
# Pi client calls:
#   GET  /pycamota/api/ota/check   → api/ota_check.php
#   POST /pycamota/api/ota/report  → api/ota_report.php
#
# Admin AJAX calls:
#   *    /pycamota/api/devices     → api/devices.php
#   *    /pycamota/api/releases    → api/releases.php
#   *    /pycamota/api/logs        → api/logs.php
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
RewriteEngine On

# Device OTA endpoints (public, authenticated by api_key)
RewriteRule ^api/ota/check$   api/ota_check.php  [L,QSA]
RewriteRule ^api/ota/report$  api/ota_report.php [L,QSA]
RewriteRule ^api/hardware_info$ api/hardware_info.php [L,QSA]

# Admin API endpoints (protected by session)
RewriteRule ^api/devices$   api/devices.php  [L,QSA]
RewriteRule ^api/releases$  api/releases.php [L,QSA]
RewriteRule ^api/logs$      api/logs.php     [L,QSA]
RewriteRule ^api/enrollment/create$ api/enrollment_create.php [L,QSA]

# One-time enrollment endpoint (public, token-based)
RewriteRule ^api/enroll$ api/enroll.php [L,QSA]

# Admin UI
RewriteRule ^admin/?$  admin/admin_dashboard.php [L,QSA]
RewriteRule ^login$    admin/admin_login.php      [L,QSA]
RewriteRule ^logout$   admin/admin_logout.php     [L,QSA]
 </IfModule>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# PHP settings (PHP 8.x compatible)
# Supports multiple PHP module names (mod_php, mod_php8, mod_php8.3, etc.)
# ---------------------------------------------------------------------------
<IfModule mod_php.c>
    php_value upload_max_filesize 52M
    php_value post_max_size 54M
    php_value max_execution_time 120
    php_value memory_limit 128M
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 52M
    php_value post_max_size 54M
    php_value max_execution_time 120
    php_value memory_limit 128M
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 52M
    php_value post_max_size 54M
    php_value max_execution_time 120
    php_value memory_limit 128M
</IfModule>

<IfModule mod_php83.c>
    php_value upload_max_filesize 52M
    php_value post_max_size 54M
    php_value max_execution_time 120
    php_value memory_limit 128M
</IfModule>
